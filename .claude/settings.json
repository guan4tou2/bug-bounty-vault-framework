{
 "hooks": {
  "PreToolUse": [
   {
    "matcher": "Write",
    "hooks": [
     {
      "type": "command",
      "command": "bash -lc 'root=\"${CLAUDE_PROJECT_DIR:-$PWD}\"; bash \"$root/automation/protect_critical_writes.sh\"'"
     }
    ]
   },
   {
    "matcher": "Bash",
    "hooks": [
     {
      "type": "command",
      "command": "bash -lc 'root=\"${CLAUDE_PROJECT_DIR:-$PWD}\"; bash \"$root/automation/low_frequency_gates.sh\"'"
     },
     {
      "type": "command",
      "command": "bash -lc 'root=\"${CLAUDE_PROJECT_DIR:-$PWD}\"; bash \"$root/automation/inline_scan_gate.sh\"'"
     }
    ]
   },
   {
    "matcher": "Read",
    "hooks": [
     {
      "type": "command",
      "command": "bash -lc 'root=\"${CLAUDE_PROJECT_DIR:-$PWD}\"; bash \"$root/automation/big_read_gate.sh\"'"
     }
    ]
   }
  ],
  "PostToolUse": [
   {
    "matcher": "Bash",
    "hooks": [
     {
      "type": "command",
      "command": "bash -lc 'root=\"${CLAUDE_PROJECT_DIR:-$PWD}\"; bash \"$root/automation/claude_audit_log.sh\"'",
      "async": true
     }
    ]
   },
   {
    "matcher": "Write|Edit",
    "hooks": [
     {
      "type": "command",
      "command": "bash -lc 'root=\"${CLAUDE_PROJECT_DIR:-$PWD}\"; bash \"$root/automation/audit_workspace.sh\" meta >/dev/null 2>&1 || true'",
      "async": true
     }
    ]
   }
  ],
  "Stop": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "bash -lc 'echo \"[session-end] Loop close-out is NOT automatic \u2014 run: bash automation/session_end_checklist.sh <target> (Knowledge Capture + audit + lock release). Skipping leaves the 4-ring learning loop open.\"'"
     }
    ]
   }
  ],
  "SessionStart": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "bash -lc 'root=\"${CLAUDE_PROJECT_DIR:-$PWD}\"; bash \"$root/automation/check_active_sessions.sh\" 2>/dev/null | head -15; echo \"[session-start] claim your scope (automation/claim.sh <scope>) + run pre-recon dedup before hunting.\"'"
     }
    ]
   }
  ]
 }
}
